EXTERNPROTO "../protos/ModelBird.proto"
EXTERNPROTO "../protos/ModelTruck.proto"

WorldInfo {
  info [
    "Applied Robotics & AI Project - Part 2: robot vision"
    "The e-puck places the three blocks at random, finds them with HSV colour detection, and photographs"
    "the airplane, bird, truck and horse (CIFAR-10 classes, fixed places, side-on to the centre) for the CNN."
  ]
  title "E-puck robot vision"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5504195897881259 -0.5450032382188699 0.6324632364876372 4.2605730036260265
  position -0.17736651175908769 1.244809241186041 5.955119923321485
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 2.5 2.5
  wallHeight 0.1
}
DEF OBJ_AIRPLANE ModelAirplane {
  translation -0.75 0.75 0
  rotation 0 0 1 0.7854
}
DEF OBJ_BIRD ModelBird {
  translation 0.75 0.75 0
  rotation 0 0 1 -0.7854
}
DEF OBJ_TRUCK ModelTruck {
  translation 0.75 -0.75 0
  rotation 0 0 1 -2.3562
}
DEF OBJ_HORSE Horse {
  translation -0.75 -0.75 0
  rotation 0 0 1 2.3562
  name "horse"
  scale 0.1
  colorBody 0.62 0.4 0.22
  colorHair 0.15 0.1 0.07
}
E-puck {
  translation 0 0 0
  controller "robot_vision_controller"
  supervisor TRUE
  camera_width 160
  camera_height 120
}
DEF RED_BLOCK ColourBlock {
  translation 0 0.65 0.05
  color 1 0 0
  name "red block"
}
DEF GREEN_BLOCK ColourBlock {
  translation 0.45 -0.65 0.05
  color 0 1 0
  name "green block"
}
DEF BLUE_BLOCK ColourBlock {
  translation -0.45 -0.65 0.05
  color 0 0 1
  name "blue block"
}
