DEF OBJ_HORSE Horse {
  translation 0 0.7 0
  rotation 0 0 1 -1.5708
  name "horse"
  scale 0.1
  colorBody 0.62 0.4 0.22
  colorHair 0.15 0.1 0.07
}
E-puck {
  translation 0 0 0
  controller "robot_vision_controller"
  supervisor TRUE
  camera_width 160
  camera_height 120
}
DEF RED_BLOCK Solid {
  translation 0 0.65 0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 0 0
        roughness 1
        metalness 0
