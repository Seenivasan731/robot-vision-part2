EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/animals/protos/Horse.proto"

WorldInfo {
  info [
    "Applied Robotics & AI Project - Part 2: robot vision"
    "The e-puck places the blocks and the CNN objects at random, finds the blocks with HSV colour detection,"
    "and photographs a model airplane, a bird, a truck and a horse (CIFAR-10 classes) for the CNN."
  ]
  title "E-puck robot vision"
  basicTimeStep 32
}
Viewpoint {
  orientation 0 1 0 0.9273
  position -2.6 0 3.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 2.5 2.5
  wallHeight 0.1
}
DEF OBJ_AIRPLANE Solid {
  translation -0.7 0 0
  children [
    DEF STAND Pose {
      translation 0 0 0.035
