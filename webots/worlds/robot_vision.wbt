EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/robots/gctronic/e-puck/protos/E-puck.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/animals/protos/Horse.proto"

WorldInfo {
  info [
    "Applied Robotics & AI Project - Part 2: robot vision"
    "The e-puck places the blocks and the CNN objects at random, finds the blocks with HSV colour detection,"
    "and photographs a model airplane, a car, a truck and a horse (CIFAR-10 classes) for the CNN."
  ]
  title "E-puck robot vision"
  basicTimeStep 32
}
Viewpoint {
  orientation 0 1 0 0.9273
  position -2.6 0 3.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 2.5 2.5
  wallHeight 0.1
}
DEF OBJ_AIRPLANE Solid {
  translation -0.7 0 0
  children [
    DEF STAND Pose {
      translation 0 0 0.035
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.25 0.25 0.27 roughness 0.6 metalness 0 }
          geometry Cylinder { height 0.07 radius 0.006 }
        }
      ]
    }
    DEF FUSELAGE Pose {
      translation 0 0 0.09
      rotation 0 1 0 1.5708
      children [
        Shape {
          appearance DEF WHITE PBRAppearance { baseColor 0.92 0.93 0.95 roughness 0.4 metalness 0 }
          geometry Capsule { height 0.24 radius 0.022 }
        }
      ]
    }
    DEF WINGS Pose {
      translation 0.01 0 0.088
      children [
        Shape {
          appearance DEF GREY PBRAppearance { baseColor 0.74 0.76 0.8 roughness 0.4 metalness 0 }
          geometry Box { size 0.07 0.3 0.008 }
        }
      ]
    }
    DEF ENGINE_LEFT Pose {
      translation 0.03 0.07 0.077
      rotation 0 1 0 1.5708
      children [
        DEF ENGINE Shape {
          appearance USE GREY
          geometry Cylinder { height 0.04 radius 0.009 }
        }
      ]
    }
    DEF ENGINE_RIGHT Pose {
      translation 0.03 -0.07 0.077
      rotation 0 1 0 1.5708
      children [ USE ENGINE ]
    }
    DEF TAIL_PLANE Pose {
      translation -0.125 0 0.098
      children [
        Shape {
          appearance USE GREY
          geometry Box { size 0.045 0.11 0.006 }
        }
      ]
    }
    DEF TAIL_FIN Pose {
      translation -0.128 0 0.125
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.35 0.38 0.45 roughness 0.4 metalness 0 }
          geometry Box { size 0.05 0.006 0.06 }
        }
      ]
    }
  ]
  name "airplane"
  boundingObject Pose {
    translation 0 0 0.075
    children [
      Box { size 0.28 0.3 0.15 }
    ]
  }
}
